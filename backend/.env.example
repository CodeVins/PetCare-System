# MySQL
DB_USERNAME=petcare
DB_PASSWORD=petcare1234

# JWT 서명 키 (충분히 긴 랜덤 값 사용: openssl rand -base64 64)
JWT_SECRET=

# 최초 관리자 계정 (앱 시작 시 자동 생성/승격됨, 비워두면 스킵)
ADMIN_EMAIL=admin@petcare.com
ADMIN_PASSWORD=

# 카카오 로그인 (REST API 키, Client Secret은 콘솔에서 켰을 때만). redirect-uri 기본값은 http://localhost:5173/oauth/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
