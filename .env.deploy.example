# 서버 ~/petcare/.env 로 복사해서 채움 (레포에 실제 값 커밋 금지)
DOMAIN=petcare-xxxx.duckdns.org
TAG=latest

DB_USERNAME=petcare
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# openssl rand -base64 64
JWT_SECRET=

ADMIN_EMAIL=admin@petcare.com
ADMIN_PASSWORD=

# 카카오 로그인 (developers.kakao.com → 앱 키 REST API 키, 카카오 로그인 → 보안 Client Secret(켰을 때만))
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://petcare-xxxx.duckdns.org/oauth/kakao/callback
